{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    "../src/vibe/prompts.ts",
    "../src/vibe/edits.ts",
    "../src/vibe/checks.ts",
    "../src/vibe/contextFormat.ts",
    "../src/study/prompts.ts",
    "../src/study/tasks.ts"
  ],
  "exclude": ["node_modules", "build", "data"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@core/*": ["../src/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
