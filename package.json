{
  "name": "eduai-ide-assistant",
  "displayName": "EduAI IDE Assistant",
  "description": "AI inside VS Code: chat panel + explain/ask selection + ask file from Explorer.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],

  "main": "./out/extension.js",

  "activationEvents": [
    "onCommand:eduai.openChat",
    "onCommand:eduai.showChat",
    "onCommand:eduai.askSelection",
    "onCommand:eduai.askFile"
  ],

  "contributes": {
    "commands": [
      { "command": "eduai.openChat", "title": "EduAI: Open Tutor Chat" },
      { "command": "eduai.showChat", "title": "EduAI: Open Chat (Legacy)" },
      { "command": "eduai.askSelection", "title": "EduAI: Ask About Selection" },
      { "command": "eduai.askFile", "title": "EduAI: Ask About This File" }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "eduai.askSelection",
          "group": "navigation@9",
          "when": "editorHasSelection && !inInteractivePlayground"
        },
        {
          "command": "eduai.openChat",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "eduai.openChat",
          "group": "navigation@9",
          "when": "resourceExtname =~ /./"
        }
      ],
      "explorer/context": [
        {
          "command": "eduai.askFile",
          "group": "navigation@9",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        { "command": "eduai.openChat" },
        { "command": "eduai.showChat" },
        { "command": "eduai.askSelection" },
        { "command": "eduai.askFile" }
      ]
    },
    "keybindings": [
      {
        "command": "eduai.openChat",
        "key": "ctrl+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "eduai.askSelection",
        "key": "ctrl+alt+/",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "EduAI",
      "properties": {
        "eduai.apiProvider": {
          "type": "string",
          "enum": ["auto", "openai", "ollama"],
          "default": "auto",
          "description": "Which backend to use (auto chooses by model name)."
        },
        "eduai.provider": {
          "type": "string",
          "enum": ["openai", "ollama"],
          "default": "openai",
          "description": "Deprecated: use 'eduai.apiProvider'."
        },
        "eduai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1/chat/completions",
          "description": "HTTP endpoint (OpenAI-compatible or your EduAI gateway)."
        },
        "eduai.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key."
        },
        "eduai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Deprecated: use 'eduai.openaiApiKey'."
        },
        "eduai.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server URL."
        },
        "eduai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Preferred model id (e.g., gpt-4o-mini or qwen3-coder:30b)."
        },
        "eduai.defaultModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Fallback model id for legacy code paths."
        },
        "eduai.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Default creativity/temperature."
        },
        "eduai.includeSelectionByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Auto-attach current editor selection when opening chat."
        }
      }
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "echo \"no tests yet\""
  },

  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.89.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.6.2"
  }
}
