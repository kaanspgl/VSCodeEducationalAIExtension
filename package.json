{
  "name": "vibelearner-ide-assistant",
  "displayName": "VibeLearner IDE Assistant",
  "description": "VibeLearner: learning-first coding tutor inside VS Code (chat + explain/ask selection + ask file).",
  "version": "0.1.0",
  "publisher": "Necmi Kaan Sapoglu",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],

  "main": "./out/extension.js",

  "activationEvents": [
    "onCommand:vibelearner.openChat",
    "onCommand:vibelearner.showChat",
    "onCommand:vibelearner.askSelection",
    "onCommand:vibelearner.askFile"
  ],

"contributes": {
  "commands": [
    { "command": "vibelearner.openChat",     "title": "VibeLearner: Focus Assistant" },
    { "command": "vibelearner.showChat",     "title": "VibeLearner: Open Chat (Legacy)" },
    { "command": "vibelearner.askSelection", "title": "VibeLearner: Ask About Selection" },
    { "command": "vibelearner.askFile",      "title": "VibeLearner: Ask About This File" },

    { "command": "vibelearner.quick.explain","title": "VibeLearner: Explain Code" },
    { "command": "vibelearner.quick.review", "title": "VibeLearner: Code Review" },
    { "command": "vibelearner.quick.plan",   "title": "VibeLearner: Plan Steps" },
    { "command": "vibelearner.quick.hints",  "title": "VibeLearner: Hints Only" },
    { "command": "vibelearner.quick.reflect","title": "VibeLearner: Reflection Prompt" },
    { "command": "vibelearner.quick.quiz",   "title": "VibeLearner: CFU Quiz" }
  ],
  "menus": {
    "editor/context": [
      {
        "command": "vibelearner.askSelection",
        "group": "navigation@9",
        "when": "editorHasSelection && !inInteractivePlayground"
      },
      {
        "command": "vibelearner.openChat",
        "group": "navigation@10",
        "when": "editorTextFocus"
      }
    ],
    "editor/title": [
      {
        "command": "vibelearner.openChat",
        "group": "navigation@9",
        "when": "resourceExtname =~ /./"
      }
    ],
    "explorer/context": [
      {
        "command": "vibelearner.askFile",
        "group": "navigation@9",
        "when": "resourceScheme == file"
      }
    ]
  },
  "keybindings": [
    { "command": "vibelearner.openChat",      "key": "ctrl+alt+e", "when": "editorTextFocus" },
    { "command": "vibelearner.askSelection",  "key": "ctrl+alt+/", "when": "editorHasSelection && editorTextFocus" },

    { "command": "vibelearner.quick.explain", "key": "ctrl+alt+1", "when": "editorTextFocus" },
    { "command": "vibelearner.quick.review",  "key": "ctrl+alt+2", "when": "editorTextFocus" },
    { "command": "vibelearner.quick.plan",    "key": "ctrl+alt+3", "when": "editorTextFocus" },
    { "command": "vibelearner.quick.hints",   "key": "ctrl+alt+4", "when": "editorTextFocus" },
    { "command": "vibelearner.quick.reflect", "key": "ctrl+alt+5", "when": "editorTextFocus" },
    { "command": "vibelearner.quick.quiz",    "key": "ctrl+alt+6", "when": "editorTextFocus" }
  ],
  "configuration": {
  "title": "VibeLearner",
  "properties": {
    "vibelearner.backendMode": {
      "type": "string",
      "default": "direct",
      "enum": ["direct", "vibelearner"],
      "enumDescriptions": [
        "Use Gemini directly from VS Code (default).",
        "Use the VibeLearner (EduAI) backend /api/chat (good for demos and local models)."
      ],
      "description": "Which backend to use for AI calls."
    },


    "vibelearner.apiUrl": {
      "type": "string",
      "default": "https://vibelearner.example.edu/api/chat",
      "description": "HTTP endpoint for the VibeLearner (EduAI) chat API (POST /api/chat). Used when backendMode = 'vibelearner'."
    },
    "vibelearner.apiKey": {
      "type": "string",
      "default": "",
      "description": "VibeLearner (EduAI) API key used in the x-api-key header. Used when backendMode = 'vibelearner'."
    },
    "vibelearner.courseCode": {
      "type": "string",
      "default": "",
      "description": "Optional course code sent with VibeLearner requests (e.g. COSC 123)."
    },
    "vibelearner.model": {
      "type": "string",
      "default": "google:gemini-2.5-flash",
      "description": "Model identifier understood by the VibeLearner backend (e.g. google:gemini-2.5-flash, ollama:gpt-oss:120b)."
    },


    "vibelearner.geminiApiKey": {
      "type": "string",
      "default": "",
      "description": "Google Gemini API key used when backendMode = 'direct'."
    },
    "vibelearner.geminiModel": {
      "type": "string",
      "default": "gemini-2.0-flash",
      "description": "Gemini model name for direct calls (e.g. gemini-2.0-flash). Used when backendMode = 'direct'."
    },


    "vibelearner.includeSelectionByDefault": {
      "type": "boolean",
      "default": true,
      "description": "Auto-attach current editor selection when opening chat."
    }
  }
}
}
}

