{
  "name": "vibelearner-ide-assistant",
  "displayName": "VibeLearner IDE Assistant",
  "description": "Research prototype: structured vibe coding (reason → code → review → check) for introductory programming.",
  "version": "0.1.0",
  "publisher": "Necmi Kaan Sapoglu",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:vibelearner.openChat",
    "onCommand:vibelearner.showChat",
    "onCommand:vibelearner.revealStudyLogs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vibelearner.openChat",
        "title": "VibeLearner: Open"
      },
      {
        "command": "vibelearner.showChat",
        "title": "VibeLearner: Show Panel"
      },
      {
        "command": "vibelearner.revealStudyLogs",
        "title": "VibeLearner: Reveal Study Logs (researcher)"
      }
    ],
    "keybindings": [
      {
        "command": "vibelearner.openChat",
        "key": "ctrl+alt+;",
        "mac": "cmd+alt+;",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "VibeLearner",
      "properties": {
        "vibelearner.apiProvider": {
          "type": "string",
          "enum": [
            "auto",
            "openai",
            "ollama",
            "gemini",
            "eduai"
          ],
          "default": "ollama",
          "description": "Which backend to use. Defaults to local Ollama."
        },
        "vibelearner.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434/api/chat",
          "description": "HTTP endpoint. For Ollama use: http://127.0.0.1:11434/api/chat"
        },
        "vibelearner.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key."
        },
        "vibelearner.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server URL."
        },
        "vibelearner.model": {
          "type": "string",
          "default": "qwen3-coder:30b",
          "description": "Preferred model id."
        },
        "vibelearner.gemini.apiKey": {
          "type": "string",
          "default": "",
          "description": "Google AI Studio / Gemini API key."
        },
        "vibelearner.gemini.model": {
          "type": "string",
          "default": "gemini-2.0-flash-lite-preview-02-05",
          "description": "Gemini model id."
        },
        "vibelearner.defaultModel": {
          "type": "string",
          "default": "qwen3-coder:30b",
          "description": "Fallback model id."
        },
        "vibelearner.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Default creativity/temperature."
        },
        "vibelearner.eduaiEndpoint": {
          "type": "string",
          "default": "https://eduai.ok.ubc.ca/api/chat",
          "description": "EduAI chat endpoint (e.g. https://eduai.ok.ubc.ca/api/chat)."
        },
        "vibelearner.eduaiApiKey": {
          "type": "string",
          "default": "",
          "description": "EduAI backend API key used for course-aware RAG."
        },
        "vibelearner.courseCode": {
          "type": "string",
          "default": "DEMO101",
          "description": "Default course code to send to EduAI for contextual RAG."
        },
        "vibelearner.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable used to run program tests (default: 'python' on Windows, 'python3' elsewhere)."
        },
        "vibelearner.study.condition": {
          "type": "string",
          "enum": [
            "vibelearner",
            "direct"
          ],
          "default": "vibelearner",
          "description": "Study condition for this participant. 'vibelearner' = structured workflow; 'direct' = plain AI code generation (control). Set before the participant begins."
        },
        "vibelearner.study.language": {
          "type": "string",
          "enum": [
            "python",
            "javascript"
          ],
          "default": "python",
          "description": "Programming language for all study tasks."
        },
        "vibelearner.study.taskIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "sum_positives",
            "letter_grade",
            "find_max",
            "count_above_average"
          ],
          "description": "Ordered task ids used when study.mode is 'tasks' (see src/study/tasks.ts)."
        },
        "vibelearner.study.maxClarifications": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum clarification rounds before code is generated anyway. Tune in the pilot."
        },
        "vibelearner.study.comprehensionQuestions": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Comprehension questions asked per task in the VibeLearner condition."
        },
        "vibelearner.study.mode": {
          "type": "string",
          "enum": [
            "open",
            "tasks"
          ],
          "default": "open",
          "description": "'open' = the student builds any program they like (AI checks the request is detailed enough, then teaches while it builds). 'tasks' = fixed instructor-designed tasks with unit tests (for the controlled study)."
        },
        "vibelearner.study.quizQuestions": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 6,
          "description": "Multiple-choice conceptual quiz questions after the code check (VibeLearner condition). 0 disables the quiz."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "echo \"no tests yet\""
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.89.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.6.2"
  }
}
