{
  "name": "eduai-ide-assistant",
  "displayName": "EduAI IDE Assistant",
  "description": "AI inside VS Code: chat panel + explain selection command.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:eduai.openChat",
    "onCommand:eduai.explainSelection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eduai.openChat",
        "title": "EduAI: Open Chat"
      },
      {
        "command": "eduai.explainSelection",
        "title": "EduAI: Explain Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "eduai.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "EduAI Settings",
      "properties": {
        "eduai.provider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "ollama"],
          "description": "Which backend to call. Use 'ollama' for http://localhost:11434."
        },
        "eduai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1/chat/completions",
          "description": "HTTP endpoint (OpenAI-compatible or your EduAI gateway)."
        },
        "eduai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API key (store securely, e.g., Settings Sync / Secrets)."
        },
        "eduai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model/preset name for your API."
        },
        "eduai.includeSelectionByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Auto-attach current editor selection when opening chat."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "echo \"no tests yet\""
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.89.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.6.2"
  },
  "activationEvents": [
    "onCommand:eduai.showChat"
  ],
  "contributes": {
    "commands": [
      { "command": "eduai.showChat", "title": "EduAI: Open Chat" }
    ],
    "configuration": {
      "title": "EduAI",
      "properties": {
        "eduai.apiProvider": {
          "type": "string",
          "enum": ["auto", "openai", "ollama"],
          "default": "auto",
          "description": "Which backend to use (auto chooses by model name)."
        },
        "eduai.defaultModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model id (e.g., gpt-4o-mini or llama3.1:8b)."
        },
        "eduai.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Default creativity/temperature."
        },
        "eduai.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key."
        },
        "eduai.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server URL."
        }
      }
    }
  }
}
